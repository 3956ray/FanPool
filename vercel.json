{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile",
  "buildCommand": "node scripts/build-public.mjs",
  "outputDirectory": "dist-public",
  "functions": {
    "api/server.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?__fp_path=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/create",
      "destination": "/index.html"
    },
    {
      "source": "/my",
      "destination": "/index.html"
    },
    {
      "source": "/manage",
      "destination": "/index.html"
    },
    {
      "source": "/pools/:address",
      "destination": "/index.html"
    },
    {
      "source": "/setup",
      "destination": "/setup.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' https: data:; font-src 'self' https://fonts.reown.com https://fonts.walletconnect.com data:; frame-src https:; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "NODEJS_HELPERS": "0"
    }
  }
}
