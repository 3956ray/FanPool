# Public configuration only. Monad testnet, never mainnet.
APP_ORIGIN=http://127.0.0.1:4174
REOWN_PROJECT_ID=5e8dc9a12760df99a9e35d05e2c5ef57
PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Leave undeployed contracts empty. Do not substitute local contracts.
PUBLIC_FACTORY=
PUBLIC_TOKEN=
PUBLIC_SUPPLIER=
PUBLIC_FULFILLMENT=
# Server only; not included in builds. Requires external connection Gate.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_DATABASE_URL=
# Exactly 64 hex characters generated securely. Never commit the value.
AUTH_TOKEN_KEY=

# Anonymous metadata reads remain independent of Hosted Auth.
# Server-only login inheriting fanpool_metadata_reader ONLY.
METADATA_READ_DATABASE_URL=
# AUTH_DATABASE_URL login must inherit fanpool_auth + fanpool_metadata_writer.
# Production exact origin (after approved Gate): https://fan-pool-eta.vercel.app

# Fixed creation receipt block, required before deployed public worker is enabled.
PUBLIC_FACTORY_DEPLOYMENT_BLOCK=
PUBLIC_FACTORY_DEPLOYMENT_HASH=
# Server-only index reader/worker logins, distinct least-privilege roles.
INDEX_READ_DATABASE_URL=
INDEX_WORKER_DATABASE_URL=
# 32 random bytes encoded as 64 hex; same value in Vault, never in browser.
INDEX_WORKER_SECRET=
